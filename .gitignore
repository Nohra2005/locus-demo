# ── Python ────────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
*.pyd
venv/
.env
.env.*

# ── OS ────────────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
~$*

# ── Node (report generation) ──────────────────────────────────────────────────
node_modules/
/package.json
/package-lock.json

# ── IDE ───────────────────────────────────────────────────────────────────────
.vscode/
.idea/
*.swp

# ── MLflow ────────────────────────────────────────────────────────────────────
# Experiment DBs and run artifacts are machine-specific — don't commit them.
# Each dev runs their own MLflow server; use the shared Qdrant cloud for data.
mlflow.db
*.db-journal
mlruns/
mlartifacts/

# ── MLops generated outputs ───────────────────────────────────────────────────
# These are auto-regenerated by evaluation scripts — no need to track them.
mlops/evaluation_results.json
mlops/visual_similarity_results.json
mlops/repair_report.json
mlops/link_health_report.json
mlops/gemini_judge_results.json
mlops/vss_cache.json

# ── Gateway runtime state ─────────────────────────────────────────────────────
# Written at runtime by the gateway process — not source code.

# ── LoRA retraining artifacts ─────────────────────────────────────────────────
# Training runs, cached image pairs, and promoted model weights are large
# machine-specific artifacts — regenerated on each training run.
mlops/lora_runs/
mlops/pairs_cache/
visual_engine/models/
mlops/.last_retrain_ts
gateway/reindex_checkpoint.json

# ── Generated reports and local planning docs ─────────────────────────────────
mlops/golden_dataset_report.html
PLAN.md
*.xlsx

# ── LaTeX report (compiled locally, not tracked) ──────────────────────────────
main.tex
*.aux
*.toc
*.out
*.synctex.gz
*.fls
*.fdb_latexmk

# ── Frontend build ────────────────────────────────────────────────────────────
frontend/dist/
frontend/node_modules/

# ── Docker ────────────────────────────────────────────────────────────────────
*.log

# ── Deployment script (contains live secrets — never commit) ──────────────────
deploy.sh

# YOLO weights are downloaded at build time
*.pt
ccr-ca.crt
