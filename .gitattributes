# Enforce LF for all text files that live inside Linux containers.
# This overrides core.autocrlf=true so Docker never sees \r\n.
*               text=auto
.gitattributes  text eol=lf
*.sh            text eol=lf
Dockerfile      text eol=lf
Dockerfile.*    text eol=lf
*.py            text eol=lf
*.yml           text eol=lf
*.yaml          text eol=lf
*.json          text eol=lf
